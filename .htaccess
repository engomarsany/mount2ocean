# ====================================================================
# MOUNT2OCEAN - FORT KNOX ENTERPRISE APACHE SECURITY CONFIGURATION
# 1000% Military-Grade Web Server & Application Firewall (WAF)
# ====================================================================

# 1. Enable UTF-8 Encoding
AddDefaultCharset UTF-8

# 2. Disable Directory Listing & Server Signatures (Anti-Reconnaissance)
Options -Indexes -MultiViews
ServerSignature Off

# 3. Explicit File Access Deny Rules (Zero-Leak Protection)
<Files "db_config.php">
    Order allow,deny
    Deny from all
    Require all denied
</Files>

<Files "security_shield.php">
    Order allow,deny
    Deny from all
    Require all denied
</Files>

<Files "database.sql">
    Order allow,deny
    Deny from all
    Require all denied
</Files>

<Files ".cpanel.yml">
    Order allow,deny
    Deny from all
    Require all denied
</Files>

<FilesMatch "\.(sql|env|ini|log|bak|conf|sh|json|yml|yaml|git|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Web Application Firewall (WAF) Rewrite Rules
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block Exploit Scanners & Malicious User-Agents
    RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|wpscan|dirbuster|havij|acunetix|zmeu|morfeus|nessus|masscan|metasploit|nmap) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (libwww-perl|python-requests|curl|wget|scanner) [NC]
    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    RewriteRule .* - [F,L]

    # Block SQL Injection Attempts in URI Query String
    RewriteCond %{QUERY_STRING} (union\s+select|cast\(|concat\(|base64_|DECLARE\s+@|<script|document\.cookie|sleep\(|benchmark\() [NC]
    RewriteRule .* - [F,L]

    # Block Directory Traversal & Remote File Inclusion (RFI)
    RewriteCond %{QUERY_STRING} (\.\./|etc/passwd|proc/self/environ|boot\.ini|/win\.ini) [NC]
    RewriteRule .* - [F,L]

    # Enforce HTTPS (SSL)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 5. Military-Grade Security Headers
<IfModule mod_headers.c>
    # HTTP Strict Transport Security (HSTS - 2 Years Enforced)
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    
    # Anti-Sniffing MIME Protection
    Header always set X-Content-Type-Options "nosniff"
    
    # Anti-Clickjacking Protection
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Cross-Site Scripting (XSS) Filter Block
    Header always set X-XSS-Protection "1; mode=block"
    
    # Strict Referrer Privacy Protection
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Cross-Origin Policies (COOP / CORP)
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set Cross-Origin-Resource-Policy "cross-origin"
    
    # Hardware & Feature Privacy Policies
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=(self)"
</IfModule>

# 6. Gzip Compression for High-Speed Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 7. Browser Cache Control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 8. Default Entry Document
DirectoryIndex customer_portal.html index.html